rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workers/{document} {
      allow read, write: if true;
    }
    match /shiftPresets/{document} {
      allow read, write: if true;
    }
    match /tasks/{document} {
      allow read, write: if true;
    }
  }
}
